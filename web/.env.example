# 근로고래 웹앱 환경변수 (실제 값은 .env.local에 — gitignore됨)
# Cloudflare Pages 배포 시 대시보드 > Settings > Environment variables 에도 동일하게 등록할 것.
# anon 키는 공개돼도 안전(RLS로 보호). service_role 키는 절대 프론트에 두지 말 것.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
